# Base de datos SQLite (ruta relativa a prisma/)
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones. En producción usa uno largo y aleatorio.
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Credenciales del admin que crea el seed (opcional)
SEED_ADMIN_EMAIL="karen@soykarengi.com"
SEED_ADMIN_PASSWORD="karengi2026"

# Gobernanza SaaS (panel Hypnos)
# Secreto compartido con hypnosapps.com. Debe ser largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOBERNANZA_MASTER_KEY="cambia-esto-por-un-hex-de-64-caracteres"
# Correo que se muestra en el aviso de vencimiento y en la pantalla de corte
NEXT_PUBLIC_GOBERNANZA_CONTACTO="hypnosapps@gmail.com"
