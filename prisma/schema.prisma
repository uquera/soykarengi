// SoyKarengi — Karen Ramos
// Una plataforma, dos unidades de negocio, una sola base de clientes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── CORE: CLIENTES ───────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  city         String?
  role         String   @default("CLIENT") // CLIENT | ADMIN
  // Lo que la persona dijo que venía a buscar al crear su cuenta:
  // ACOMPANAMIENTO | DISENOS | AMBAS. El segmento real se calcula aparte.
  interest     String?
  /// Karen usa el panel sencillo (/panel): solo las tareas del día. Hypnos
  /// usa el panel completo (/admin). Se cambia desde Ajustes.
  panelSimple  Boolean  @default(false)
  createdAt    DateTime @default(now())

  appointments   Appointment[]
  designRequests DesignRequest[]
  favorites      Favorite[]
  archivos       Archivo[] @relation("CarpetaDeCliente")
  subidos        Archivo[] @relation("SubidoPor")
  aceptaciones   Aceptacion[]
  tokens         TokenClave[]

  @@index([role])
}

// ──────────────────── UNIDAD 1 · ACOMPAÑAMIENTO ────────────────────

model Service {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  summary       String
  description   String
  forWho        String // ¿Para quién es?
  whatToExpect  String // ¿Qué puedes esperar?
  modality      String // Online | Presencial | Ambas
  durationMin   Int
  price         Int
  specialty     String  @default("Acompañamiento")
  /// Cuando el valor no es una cifra cerrada (un programa completo, una sesión
  /// sin costo), esta nota reemplaza al precio en la ficha.
  priceNote     String?
  accentEmoji   String  @default("✦")
  order         Int     @default(0)
  active        Boolean @default(true)

  // Versión en inglés. Si está vacía, la web cae al español.
  nameEn         String?
  summaryEn      String?
  descriptionEn  String?
  forWhoEn       String?
  whatToExpectEn String?
  specialtyEn    String?
  modalityEn     String?
  priceNoteEn    String?

  appointments Appointment[]
}

model Appointment {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  serviceId String
  startsAt  DateTime
  modality  String
  status    String   @default("PENDIENTE") // PENDIENTE | CONFIRMADA | COMPLETADA | CANCELADA
  reason    String // motivo de consulta (formulario previo)
  firstTime Boolean  @default(true)
  notes     String? // notas internas de Karen
  /// Enlace de la videollamada (Zoom, Meet…). Lo pone Karen y lo ve la clienta.
  meetingUrl String?
  /// Precio del servicio al reservar: si Karen cambia la tarifa después, las
  /// sesiones ya agendadas no cambian de valor en Finanzas.
  price      Int?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([startsAt])
  @@index([userId])
  @@index([status])
}

/// Horas que Karen bloquea en su agenda: vacaciones, personal, bloques reservados.
/// Un bloqueo de día completo va de 00:00 a 00:00 del día siguiente.
model Blackout {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  allDay    Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  @@index([startsAt])
}

// ─────────────── UNIDAD 2 · DISEÑOS CON PROPÓSITO ───────────────

model DesignCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  group       String // EVENTOS | PERSONAL | PROPOSITO
  description String
  order       Int     @default(0)
  active      Boolean @default(true)

  nameEn        String?
  descriptionEn String?

  designs Design[]
}

model Design {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String
  description String
  categoryId  String
  basePrice   Int
  delivery    String  @default("Digital / Impresa / Ambas")
  // Campos personalizables, separados por coma: Nombre,Fecha,Frase,Fotografía,Colores,Formato
  customFields String @default("Nombre,Fecha,Frase,Fotografía,Colores,Formato")
  palette     String  @default("rose") // rose | gold | sage | clay | plum
  featured    Boolean @default(false)
  order       Int     @default(0)
  active      Boolean @default(true)

  /// Foto real de la pieza. Si falta, la vitrina dibuja una portada generada.
  image String?

  /// Intenciones a las que responde, separadas por coma: celebrar,regalar,
  /// homenajear,inspirar,compartir. Vacío = se deduce del grupo de la categoría.
  intents String?

  nameEn         String?
  taglineEn      String?
  descriptionEn  String?
  deliveryEn     String?
  customFieldsEn String?

  category  DesignCategory  @relation(fields: [categoryId], references: [id])
  requests  DesignRequest[]
  favorites Favorite[]
}

// Solicitud de diseño = configurador + cotización + pedido + entrega
model DesignRequest {
  id       String  @id @default(cuid())
  code     String  @unique
  userId   String
  designId String?

  // Configurador
  purpose   String // Evento | Regalo | Recuerdo | Homenaje | Diseño personal | Otro
  recipient String // ¿Para quién es?
  emotions  String // Amor,Gratitud,Alegría,...
  eventDate DateTime?
  format    String // Digital | Impresa | Ambas
  quantity  Int      @default(1)
  details   String   @default("") // preferencias, textos
  idea      String // "Cuéntanos tu idea"

  // Pipeline: SOLICITUD → COTIZADA → APROBADA → PAGADA → EN_DISENO → REVISION → APROBACION_FINAL → ENTREGADA
  status      String    @default("SOLICITUD")
  quoteAmount Int?
  quoteNotes  String?
  quotedAt    DateTime?
  paidAt      DateTime?
  deliveredAt DateTime?
  adminNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  design       Design?       @relation(fields: [designId], references: [id])
  attachments  Attachment[]
  deliverables Deliverable[]
  archivos     Archivo[]

  @@index([userId])
  @@index([status])
}

model Attachment {
  id        String   @id @default(cuid())
  requestId String
  name      String
  note      String   @default("")
  createdAt DateTime @default(now())

  request DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

/// Archivos reales guardados en el servidor, fuera de /public: solo se
/// descargan por /api/archivos/[id], que comprueba de quién son.
model Archivo {
  id     String @id @default(cuid())
  nombre String // nombre original, saneado, el que ve la gente
  mime   String
  tamano Int // bytes
  ruta   String @unique // nombre en disco (uuid.ext) dentro de UPLOADS_DIR

  /// COMPARTIDO  Karen → clienta (materiales, documentos)
  /// DE_CLIENTA  clienta → Karen
  /// REFERENCIA  fotos y referencias del configurador
  /// ENTREGABLE  archivos finales de una solicitud de diseño
  /// VITRINA     fotos de las piezas de la vitrina (públicas)
  tipo String
  nota String @default("")

  /// Carpeta de la clienta a la que pertenece. Null en VITRINA.
  userId      String?
  requestId   String?
  subidoPorId String
  vistoAt     DateTime? // la primera vez que la destinataria lo abrió
  createdAt   DateTime  @default(now())

  user      User?          @relation("CarpetaDeCliente", fields: [userId], references: [id], onDelete: Cascade)
  request   DesignRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  subidoPor User           @relation("SubidoPor", fields: [subidoPorId], references: [id])

  @@index([userId, tipo])
  @@index([requestId])
}

model Deliverable {
  id        String   @id @default(cuid())
  requestId String
  name      String
  url       String
  createdAt DateTime @default(now())

  request DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Favorite {
  id       String @id @default(cuid())
  userId   String
  designId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([userId, designId])
}

// ───────────────────────────── FINANZAS ─────────────────────────────
//
// Los ingresos de la plataforma ya viven en los datos: una cita COMPLETADA
// vale el precio de su servicio, y un pedido pagado vale su cotización. Este
// modelo registra lo que no pasa por ahí: los egresos del negocio y las
// ventas que ocurren fuera del sitio (ferias, encargos por WhatsApp).
model Movement {
  id        String   @id @default(cuid())
  kind      String // INGRESO | EGRESO
  concept   String
  category  String
  amount    Float
  method    String   @default("TRANSFERENCIA") // EFECTIVO | TRANSFERENCIA | TARJETA | OTRO
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([kind])
}

// ───────────────────────── CONTENIDO ─────────────────────────

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  kind        String    @default("BLOG") // BLOG | RECURSO
  tag         String    @default("")
  readMinutes Int       @default(4)
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())

  titleEn   String?
  excerptEn String?
  contentEn String?
  tagEn     String?

  @@index([kind])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  unit      String   @default("General") // Acompañamiento | Diseños | General
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ───────────────────── GOBERNANZA · LICENCIA SaaS ─────────────────────
//
// Singleton: una sola fila por instalación, sin FK, porque es configuración
// del deployment y no dato de negocio. El operador (Hypnos) la actualiza con
// PATCH /api/gobernanza/licencia usando el header X-Master-Key.
//
// El estándar de hypnos-panel define `plan` como enum, pero SQLite no tiene
// enums: se guarda como texto con los mismos valores (BASICO | PRO | ENTERPRISE).

model Licencia {
  id               String   @id @default("singleton")
  plan             String   @default("BASICO")
  fechaVencimiento DateTime
  suspendida       Boolean  @default(false)
  notasAdmin       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pagos PagoLicencia[]

  @@map("licencia")
}

/// Historial de pagos de la licencia. Lo puebla el panel de Hypnos con
/// POST /api/gobernanza/pagos; Karen solo lo lee desde /admin/licencia.
model PagoLicencia {
  id            String   @id @default(cuid())
  licenciaId    String   @default("singleton")
  monto         Float
  moneda        String   @default("USD")
  periodoInicio DateTime
  periodoFin    DateTime
  fechaPago     DateTime @default(now())
  notas         String?
  createdAt     DateTime @default(now())

  licencia Licencia @relation(fields: [licenciaId], references: [id], onDelete: Cascade)

  @@index([fechaPago])
  @@map("pagos_licencia")
}

// ──────────────────── CONFIGURACIÓN Y DOCUMENTOS LEGALES ────────────────────

/// Lo que Karen edita desde /admin/configuracion. Una sola fila ("general").
/// Los campos vacíos caen a los valores por defecto de src/lib/config.ts.
model Configuracion {
  id                String   @id @default("general")
  contactoEmail     String   @default("")
  whatsapp          String   @default("")
  instagram         String   @default("")
  /// Dirección de la consulta presencial. Vacía = solo online.
  direccion         String   @default("")
  /// JSON {"1":[10,11,12],...} con las horas de inicio por día (0 = domingo).
  horario           String   @default("")
  /// Antelación mínima para que una clienta cancele sola desde su espacio.
  cancelacionHoras  Int      @default(24)
  cancelacionTexto  String   @default("")
  instruccionesPago String   @default("")
  avisoCrisis       String   @default("")
  updatedAt         DateTime @updatedAt
}

/// Privacidad, términos y consentimiento informado, con versiones: cada
/// cambio publicado es una versión nueva y las anteriores quedan intactas,
/// porque una aceptación tiene que poder mostrar el texto exacto que se aceptó.
model DocumentoLegal {
  id        String   @id @default(cuid())
  tipo      String // PRIVACIDAD | TERMINOS | CONSENTIMIENTO
  version   Int
  titulo    String
  contenido String
  createdAt DateTime @default(now())

  aceptaciones Aceptacion[]

  @@unique([tipo, version])
}

model Aceptacion {
  id          String   @id @default(cuid())
  userId      String
  documentoId String
  aceptadoAt  DateTime @default(now())
  ip          String?
  userAgent   String?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  documento DocumentoLegal @relation(fields: [documentoId], references: [id])

  @@unique([userId, documentoId])
}

/// Enlaces de un solo uso para recuperar la contraseña o activar una cuenta
/// creada por Karen. Se guarda la huella SHA-256, nunca el token: quien lea la
/// base no puede usar los enlaces pendientes.
model TokenClave {
  id        String    @id @default(cuid())
  userId    String
  hash      String    @unique
  proposito String // RECUPERAR | ACTIVAR
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Botones de los correos que Karen puede usar sin entrar al panel (por
/// ahora: confirmar una cita). Un solo uso, vencen, y se guarda la huella.
/// El enlace abre una pantalla con un «Sí» explícito: algunos correos abren
/// los enlaces solos para revisarlos, y eso no puede confirmar nada.
model AccionCorreo {
  id        String    @id @default(cuid())
  hash      String    @unique
  tipo      String // CONFIRMAR_CITA
  refId     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([refId])
}
